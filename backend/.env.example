FLASK_ENV=development
PORT=5000
CORS_ORIGINS=http://192.168.61.41:5173,http://192.168.61.41:8080
# In development, all /api/* origins are allowed automatically.
# Set CORS_ALLOW_ALL=false to restrict to CORS_ORIGINS only.
CORS_ALLOW_ALL=true

ORACLE_USER=RFSS
ORACLE_PASSWORD=rfss
ORACLE_DSN=192.168.1.225:1521/rgc
ORACLE_CUSTOMERS_VIEW=CUSTOMERS
ORACLE_CUSTOMER_AGE_VIEW=CUSTOMERAGEVIEW
# Customer is "missing" when last bill (BILLDATE) is older than this many days.
MISSING_DAYS=30
ORACLE_BILLHDR_TABLE=BILLHDR
ORACLE_BILLDTL_TABLE=BILLDTL
ORACLE_ITEMMASTER_TABLE=ITEMMASTER
ORACLE_ROUTES_TABLE=TBLROUTES
ORACLE_LOGIN_USERS_TABLE=CRGS_USER
ORACLE_DESIGNATION_TABLE=CRGS_DESIGNATION
ORACLE_SALE_TARGETS_TABLE=CRGS_SALETARGET
ORACLE_PRODUCT_TARGETS_TABLE=CRGS_PRODUCTTARGET
ORACLE_CUSTOMER_TARGETS_TABLE=CRGS_CUSTOMERTARGET
ORACLE_TASKS_TABLE=CRGS_TASK
ORACLE_VISITDETAILS_TABLE=CRGS_VISITDETAILS
ORACLE_ORDERHDR_TABLE=CRGS_ORDERHDR
ORACLE_ORDERDTL_TABLE=CRGS_ORDERDTL
ORACLE_CONTACTINFO_TABLE=CRGS_CONTACTINFO
ORACLE_PRODUCT_REVIEW_TABLE=CRGS_PRODUCTREVIEW
# Optional override for product-review photo storage
# PRODUCT_REVIEW_UPLOAD_DIR=
# Required for older Oracle DB versions (thin mode unsupported).
# Example: C:\oracle\instantclient_19_26
ORACLE_CLIENT_LIB_DIR=
