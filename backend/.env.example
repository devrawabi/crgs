FLASK_ENV=production
FLASK_DEBUG=0
PORT=5318
# Min 32 chars. Rotate if this value was ever committed to git.
SECRET_KEY=change-me-to-a-long-random-hex-string-at-least-32-chars
SECRET_KEY_MIN_LENGTH=32
JWT_EXPIRE_HOURS=4
CORS_ORIGINS=https://crgs.rfoodinternational.com,http://127.0.0.1:5317,http://localhost:5317
# Must stay false outside development (boot rejects CORS_ALLOW_ALL in production).
CORS_ALLOW_ALL=false
# Cloudflare / reverse proxy: use CF-Connecting-IP for rate limits (ignore XFF).
TRUST_PROXY=true
# Full admin portal (all tabs including Dashboard + User Management).
ADMIN_ROLE_CODES=1,3,4,6,8
# Manager portal (all tabs except Dashboard + User Management).
MANAGER_ROLE_CODES=2,5
# Call Center only.
CALL_CENTER_ROLE_CODES=9
REQUIRE_ADMIN_ROLES=true
PASSWORD_MIN_LENGTH=8
# Temporary only while migrating legacy plaintext passwords to bcrypt.
ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_CUSTOMERS_VIEW=CUSTOMERS
ORACLE_CUSTOMER_AGE_VIEW=CUSTOMERAGEVIEW
# Cash dues for Outstanding tab (join on CUSTOMERCODE = CUST_CODE).
ORACLE_CASH_CUSTOMER_BALANCE_VIEW=CASHCUSTOMERBALANCE
MISSING_DAYS=30
ORACLE_BILLHDR_TABLE=BILLHDR
ORACLE_BILLDTL_TABLE=BILLDTL
ORACLE_ITEMMASTER_TABLE=ITEMMASTER
# Delta product sync: set after applying LAST_UPDATED (see sql/itemmaster_indexes.sql).
# Leave empty to auto-detect LAST_UPDATED / LASTUPDATED / UPDATED_AT / MODIFIED_DATE.
ORACLE_ITEMMASTER_UPDATED_COLUMN=LAST_UPDATED
# Align pool max with Waitress threads (see WAITRESS_THREADS / run.py).
ORACLE_POOL_MIN=4
ORACLE_POOL_MAX=16
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=30
ORACLE_POOL_PING_INTERVAL=60
ORACLE_POOL_MAX_LIFETIME=3600
ORACLE_STMT_CACHE_SIZE=30
ORACLE_CURSOR_ARRAYSIZE=500
# Concurrent request workers (keep <= ORACLE_POOL_MAX).
WAITRESS_THREADS=12
ORACLE_ROUTES_TABLE=TBLROUTES
ORACLE_LOGIN_USERS_TABLE=CRGS_USER
ORACLE_DESIGNATION_TABLE=CRGS_DESIGNATION
ORACLE_SALE_TARGETS_TABLE=CRGS_SALETARGET
ORACLE_PRODUCT_TARGETS_TABLE=CRGS_PRODUCTTARGET
ORACLE_CUSTOMER_TARGETS_TABLE=CRGS_CUSTOMERTARGET
ORACLE_TASKS_TABLE=CRGS_TASK
ORACLE_VISITDETAILS_TABLE=CRGS_VISITDETAILS
ORACLE_ORDERHDR_TABLE=CRGS_ORDERHDR
ORACLE_ORDERDTL_TABLE=CRGS_ORDERDTL
ORACLE_CONTACTINFO_TABLE=CRGS_CONTACTINFO
ORACLE_PRODUCT_REVIEW_TABLE=CRGS_PRODUCTREVIEW
ORACLE_MARKETRESEARCH_TABLE=CRGS_MARKETRESEARCH
ORACLE_WORKREPORT_TABLE=CRGS_WORKREPORT
# Required for older Oracle DB versions (thin mode unsupported).
ORACLE_CLIENT_LIB_DIR=
MAX_CONTENT_LENGTH=10485760
